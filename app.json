{
  "expo": {
    "name": "Servos",
    "slug": "servos",
    "scheme": "servos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.servosapp.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:servosapp.com",
        "applinks:www.servosapp.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ]
      }
    },
    "android": {
      "package": "com.servosapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2F0EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "servosapp.com",
              "pathPrefix": "/entrar"
            },
            {
              "scheme": "https",
              "host": "www.servosapp.com",
              "pathPrefix": "/entrar"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F0EC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#100E0B",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D83B0C",
          "defaultChannel": "escalas"
        }
      ],
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "O Servos adiciona suas escalas à agenda do celular, com lembrete. Ele não lê seus outros compromissos.",
          "calendarPermission": "O Servos adiciona suas escalas à agenda do celular, com lembrete.",
          "remindersPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Servos usa suas fotos para a foto de perfil e para anexar arquivos à escala.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "pt-BR": "./locales/pt-BR.json"
    }
  }
}
