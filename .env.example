# URL da API Next.js do Servos-v3 (sem /api no final).
# Em desenvolvimento local: http://<ip-do-mac>:3000 (o simulador iOS aceita http://localhost:3000).
EXPO_PUBLIC_API_URL=https://servos-server.vercel.app

# Entrar com Google e Apple (opcional). Apple precisa só da chave do Firebase;
# Google precisa dos três.
# Google Cloud → Credenciais: um ID OAuth "Web" e um "iOS" (bundle com.servosapp.app).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Mesma chave pública do web (NEXT_PUBLIC_FIREBASE_API_KEY).
EXPO_PUBLIC_FIREBASE_API_KEY=

# Monitoramento de erros (opcional). Sem o DSN, nada é enviado.
EXPO_PUBLIC_SENTRY_DSN=
# Envio dos mapas de código no build (EAS): SENTRY_AUTH_TOKEN fica como segredo no EAS.
SENTRY_ORG=
SENTRY_PROJECT=
